{
  "name": "zenshape",
  "productName": "Zenshape",
  "version": "0.3.2",
  "private": true,
  "description": "Onshape in a dedicated desktop window",
  "repository": {
    "type": "git",
    "url": "https://github.com/davemadethis/zenshape.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": {
    "name": "Dave Seeman"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "prestart": "scripts/dev-bundle.sh",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "test:ui": "vitest run -c vitest.ui.config.mts",
    "test:smoke": "vitest run -c vitest.smoke.config.mts",
    "ui:probe": "ZS_PROBE=1 vitest run -c vitest.ui.config.mts probe",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check src test *.mts",
    "lint:fix": "oxlint --fix && oxfmt --write src test *.mts"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.6.5",
    "electron": "45.0.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "update-electron-app": "^3.3.0"
  },
  "allowScripts": {
    "macos-alias@0.2.12": true,
    "fs-xattr@0.3.1": true,
    "electron-winstaller@5.4.4": true
  }
}
